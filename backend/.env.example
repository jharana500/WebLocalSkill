DATABASE_URL="postgresql://username:password@localhost:5432/localskill"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
PORT=5000
CLIENT_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"
UPLOAD_DIR="./uploads"
NODE_ENV="development"

# Email (SMTP) — leave unset in development to use the console-logged
# reset-link fallback instead of sending real email.
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="LocalSkill <no-reply@localskill.com.np>"
CONTACT_INBOX_EMAIL="hello@localskill.com.np"

# Local development admin bootstrap (used by `npm run admin:create`)
ADMIN_NAME="LocalSkill Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace_with_secure_password"
ADMIN_PASSWORD_FORCE_UPDATE="false"
